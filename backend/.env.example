# Obrigatória para coleta real: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Opcional. Sem esta chave, o analisador usa o fallback léxico/local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Compatibilidade com provedores que implementam a API OpenAI:
# OPENAI_BASE_URL=http://localhost:11434/v1

MAX_VIDEOS=5
MAX_COMMENTS=100
ANALYSIS_CONCURRENCY=5

# Ative para executar o dashboard com comentários sintéticos e sem YouTube.
DEMO_MODE=false

# Origens separadas por vírgula. O frontend servido pelo FastAPI já usa mesma origem.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
