# YouTube Data API v3
# Obtenha em: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=sua_chave_youtube_aqui

# OpenAI (ou compatível) para análise de sentimento + geolocalização
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_chave_openai_aqui

# Opcional: base URL e modelo (padrão OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Se true, usa dados simulados quando as chaves estiverem ausentes
DEMO_MODE=true

# Limites de coleta
MAX_VIDEOS=5
MAX_COMMENTS_PER_VIDEO=20
