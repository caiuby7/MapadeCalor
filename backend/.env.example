# ── APIs de busca gratuitas ──────────────────────────────────

# YouTube Data API v3 (Google Cloud Console — cota gratuita diária)
YOUTUBE_API_KEY=sua_chave_youtube_aqui

# Reddit API (reddit.com/prefs/apps — tipo "script", gratuito)
REDDIT_CLIENT_ID=seu_client_id
REDDIT_CLIENT_SECRET=seu_client_secret
REDDIT_USER_AGENT=MapaDeCalor/1.0 by /u/seu_usuario

# Bluesky — busca pública funciona SEM credenciais
# BLUESKY_HANDLE e BLUESKY_APP_PASSWORD são opcionais

# Notícias RSS — funciona SEM credenciais (G1, Folha, UOL, etc.)

# ── LLM para análise de sentimento (gratuito) ──────────────────

# Groq — recomendado (console.groq.com)
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI — alternativa
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini
