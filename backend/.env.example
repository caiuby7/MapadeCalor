# ── YouTube Data API v3 ──────────────────────────────────────
YOUTUBE_API_KEY=sua_chave_google_cloud_aqui

# ── Bluesky (opcional — busca pública funciona sem credenciais) ─
BLUESKY_HANDLE=seu_usuario.bsky.social
BLUESKY_APP_PASSWORD=sua_senha_de_app
BLUESKY_API_URL=https://public.api.bsky.app

# ── Reddit API (app script em reddit.com/prefs/apps) ─────────
REDDIT_CLIENT_ID=seu_client_id
REDDIT_CLIENT_SECRET=seu_client_secret
REDDIT_USER_AGENT=MapaDeCalor/1.0 by /u/seu_usuario

# ── LLM para análise de sentimento (use Groq OU HuggingFace) ──
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant

HUGGINGFACE_API_KEY=sua_chave_hf_aqui
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
